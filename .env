# Copy this file to `.env` and fill in your Supabase project values.
# `.env` is gitignored; this example is committed with placeholders only.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=https://tfhhwqmnhrcjefeafzot.supabase.co

# Your Supabase project "anon" (public) API key. This is a public client
# credential by design — RLS, not key secrecy, enforces authorization.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRmaGh3cW1uaHJjamVmZWFmem90Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE0NjU5ODYsImV4cCI6MjEwNzA0MTk4Nn0.a-Pb-UfsSBdUfyYLUrqD8XEz_D-lu42Ux1Hdkj8MA0o

# Optional. Set to "1" to force the data hooks to use polling instead of
# Realtime (useful if anon Realtime delivery is unreliable on your project).
# VITE_REALTIME_FALLBACK=0
